# Public, non-secret settings only: every VITE_ variable is visible in the browser bundle.

# Leave empty to call the API on the same origin (recommended: the dev server proxies /api,
# and production routes /api on each store's own host). Set only if the API lives elsewhere.
VITE_API_BASE_URL=

# Dev server only: where `/api` is proxied. Not shipped to the browser.
DEV_API_TARGET=http://localhost:4000
