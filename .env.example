# Public, non-secret settings only: every VITE_ variable is visible in the browser bundle.

# Leave empty to call the API on the same origin (recommended: the dev server proxies /api,
# and production routes /api on each store's own host). Set only if the API lives elsewhere.
VITE_API_BASE_URL=

# Dev server only: where `/api` is proxied. Not shipped to the browser.
DEV_API_TARGET=http://localhost:4000

# Set to true to run Uploads / Column mapping / Review / Upload history against the real /api/uploads endpoints.
# Leave unset (default) to keep those screens on the local demo data.
VITE_REAL_UPLOADS=

# Set to true to run Catalogue / Product detail / New products / Categories against the real /api/products and
# /api/categories endpoints. Leave unset (default) to keep those screens on the local demo data.
VITE_REAL_CATALOGUE=

# Set to true to run the Dashboard and the Stock / Price reports against the real /api/recon endpoints (summary, rows,
# recompute). Leave unset (default) to keep those screens on the local demo data. Row clicks open the product detail,
# which shows real products only with VITE_REAL_CATALOGUE=true as well.
VITE_REAL_RECON=

